# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible provider works; only these variables decide which model is used.

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=PASTE_YOUR_KEY_HERE
# Copy the current free Flash model ID from the model list in Google AI Studio.
# Model IDs are retired from time to time, so this is deliberately NOT filled in.
LLM_MODEL=PASTE_CURRENT_MODEL_ID_HERE
# Optional: a cheaper/faster model for Practice mode. Defaults to LLM_MODEL.
LLM_MODEL_FAST=
# Optional: cap on the length of each answer (default 3000 tokens).
LLM_MAX_TOKENS=
